      {
        "id": 27,
        "type": "stat",
        "title": "Ambiguous settlements (24h)",
        "description": "Inventory settlements quarantined because one transaction emitted multiple OperatorDeposits or multiple OperatorWithdraws and the legs could not be safely paired. Each one is a held-back settlement.",
        "datasource": {
          "type": "stackdriver",
          "uid": "cloudmon"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "stackdriver",
              "uid": "cloudmon"
            },
            "queryType": "promQL",
            "promQLQuery": {
              "projectName": "$env",
              "expr": "sum(increase(inventory_ambiguous_settlement_total[24h])) or vector(0)",
              "step": "60s"
            },
            "timeSeriesList": {
              "projectName": "",
              "filters": [],
              "view": "FULL",
              "groupBys": []
            },
            "instant": true
          }
        ],
        "transparent": true,
        "gridPos": {
          "h": 5,
          "w": 6,
          "x": 0,
          "y": 61
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "special",
                "options": {
                  "match": "null+nan",
                  "result": {
                    "text": "NO DATA",
                    "color": "text",
                    "index": 99
                  }
                }
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 1
                }
              ]
            },
            "displayName": "QUARANTINED",
            "unit": "short",
            "decimals": 0
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "textMode": "value_and_name",
          "justifyMode": "center",
          "text": {
            "titleSize": 14,
            "valueSize": 34
          },
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          }
        }
      },
