    "panels": [
      {
        "id": 15,
        "type": "timeseries",
        "title": "Hedge fill latency percentiles",
        "description": "Wall-clock seconds from hedge order placement to confirmed fill. The app builds these as a metrics-rs summary (no explicit buckets), so the quantiles come straight off the {quantile=...} label rather than from histogram_quantile. This is the metrics-side view of the SPA's 'Latency percentiles over time' chart \u2014 that chart's per-stage waterfall (detection / decision / submission / execution) comes from the telemetry tables in SQLite and has no metric behind it.",
        "datasource": {
          "type": "stackdriver",
          "uid": "cloudmon"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "stackdriver",
              "uid": "cloudmon"
            },
            "queryType": "promQL",
            "promQLQuery": {
              "projectName": "$env",
              "expr": "max(hedge_fill_latency_seconds{quantile=\"0.5\"})",
              "step": "60s",
              "legendFormat": "p50"
            },
            "timeSeriesList": {
              "projectName": "",
              "filters": [],
              "view": "FULL",
              "groupBys": []
            }
          },
          {
            "refId": "B",
