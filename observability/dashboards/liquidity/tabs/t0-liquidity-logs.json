    {
      "id": 115,
      "type": "table",
      "title": "Log History",
      "description": "The bot's structured log lines, re-emitted by the exporter with real severity and target (the raw container stream is all-INFO). Filter with the level/category/target/search variables above. \u26a0\ufe0f Only the newest matching entries, about the panel's pixel width of them. Narrow the filters, or use the SPA for deep digs. DEBUG/TRACE are not shipped.",
      "datasource": {
        "type": "googlecloud-logging-datasource",
        "uid": "cloudlog"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "googlecloud-logging-datasource",
            "uid": "cloudlog"
          },
          "projectId": "$env",
          "queryText": "logName=\"projects/$env/logs/liquidity-botlogs\" labels.level=~\"^(${level:pipe})$\" labels.target=~\"${target}\" labels.target=~\"^(${category:pipe})$\" jsonPayload.message=~\"${search}\"",
          "queryType": "logs"
        }
      ],
      "gridPos": {
        "h": 19,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(timestamp|jsonPayload\\.level|jsonPayload\\.target|body)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "timestamp": 0,
              "jsonPayload.level": 1,
              "jsonPayload.target": 2,
              "body": 3
            },
            "renameByName": {
              "timestamp": "Time",
              "jsonPayload.level": "Level",
              "jsonPayload.target": "Target",
              "body": "Message"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Level"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Target"
            },
