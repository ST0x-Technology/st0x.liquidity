    {
      "id": 14,
      "type": "stat",
      "title": "",
      "description": "The SPA header's connection light: is the bot process up and answering /health? '\u2014' means the exporter itself is not reporting.",
      "datasource": {
        "type": "stackdriver",
        "uid": "cloudmon"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "cloudmon"
          },
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "$env",
            "expr": "max(liq_up{job=\"t0-liquidity-exporter\"})",
            "step": "60s"
          },
          "timeSeriesList": {
            "projectName": "",
            "filters": [],
            "view": "FULL",
            "groupBys": []
          },
          "instant": true
        }
      ],
      "transparent": true,
      "gridPos": {
        "h": 1,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Connected",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Disconnected",
                  "color": "red",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "\u2014",
                  "color": "text",
                  "index": 99
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short",
          "displayName": "Bot"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "text": {
          "valueSize": 14,
          "titleSize": 12
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "timeFrom": "5m",
      "hideTimeOverride": true
    },
    {
      "id": 15,
      "type": "stat",
      "title": "",
      "description": "Deployed commit, from /health, cut to 7 characters like the SPA header. The stackdriver plugin runs a range query even for an instant target, so over the dashboard's 24h the previous commit is a second series and its name drew over this one. PromQL also keeps a stopped series for its 5m lookback, so topk on the sample timestamp keeps only the commit with the newest sample, over a 1m window.",
      "datasource": {
        "type": "stackdriver",
        "uid": "cloudmon"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "cloudmon"
          },
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "$env",
            "expr": "max by (git_commit) (topk(1, label_replace(timestamp(liq_bot_info{job=\"t0-liquidity-exporter\"}), \"git_commit\", \"$1\", \"git_commit\", \"(.{7}).*\")))",
            "step": "60s"
          },
          "timeSeriesList": {
            "projectName": "",
            "filters": [],
            "view": "FULL",
            "groupBys": []
          },
          "instant": true,
          "legendFormat": "{{git_commit}}"
        }
      ],
      "transparent": true,
      "gridPos": {
        "h": 1,
        "w": 3,
        "x": 3,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "\u2014",
                  "color": "text",
                  "index": 99
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "center",
        "text": {
          "valueSize": 14,
          "titleSize": 12
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "timeFrom": "1m",
      "hideTimeOverride": true
    },
