    {
      "id": 21,
      "type": "table",
      "title": "Raindex Orders",
      "description": "The SPA's Orders tab, columns in SPA order (Output | Input | Vault Balance | IO Ratio | Order Hash | Created). Shipped by the exporter's collect_orders() as one Cloud Logging row per order per poll cycle (logName liquidity-orders); insertId buckets by poll-hour so a still-active order dedupes to ~1 stored row/hour rather than one per 60s poll \u2014 with a 2h window that means a couple of rows per order is expected, not a bug. Created is the order's own on-chain creation time (jsonPayload.created_at), not the row's ingestion time. The datasource returns at most about the panel's pixel width in entries.",
      "datasource": {
        "type": "googlecloud-logging-datasource",
        "uid": "cloudlog"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "googlecloud-logging-datasource",
            "uid": "cloudlog"
          },
          "projectId": "$env",
          "queryText": "logName=\"projects/$env/logs/liquidity-orders\"",
          "queryType": "logs"
        }
      ],
      "timeFrom": "2h",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(timestamp|jsonPayload\\.output|jsonPayload\\.input|jsonPayload\\.vault_balance|jsonPayload\\.io_ratio|jsonPayload\\.order_hash|jsonPayload\\.created_at)$"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "jsonPayload.vault_balance",
                "destinationType": "number"
              },
              {
                "targetField": "jsonPayload.io_ratio",
                "destinationType": "number"
              },
              {
                "targetField": "jsonPayload.created_at",
                "destinationType": "time"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "timestamp": true
            },
            "indexByName": {
              "timestamp": 0,
              "jsonPayload.output": 1,
              "jsonPayload.input": 2,
              "jsonPayload.vault_balance": 3,
              "jsonPayload.io_ratio": 4,
              "jsonPayload.order_hash": 5,
              "jsonPayload.created_at": 6
            },
            "renameByName": {
              "timestamp": "Time",
              "jsonPayload.output": "Output",
              "jsonPayload.input": "Input",
              "jsonPayload.vault_balance": "Vault Balance",
              "jsonPayload.io_ratio": "IO Ratio",
              "jsonPayload.order_hash": "Order Hash",
              "jsonPayload.created_at": "Created"
            }
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "Order Hash": {
                "operation": "groupby",
                "aggregations": []
              },
              "Output": {
                "operation": "aggregate",
                "aggregations": [
                  "first"
                ]
              },
              "Input": {
                "operation": "aggregate",
                "aggregations": [
                  "first"
                ]
              },
              "Vault Balance": {
                "operation": "aggregate",
                "aggregations": [
                  "first"
                ]
              },
              "IO Ratio": {
                "operation": "aggregate",
                "aggregations": [
                  "first"
                ]
              },
              "Created": {
                "operation": "aggregate",
                "aggregations": [
                  "first"
                ]
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "Output (first)": 0,
              "Input (first)": 1,
              "Vault Balance (first)": 2,
              "IO Ratio (first)": 3,
              "Order Hash": 4,
              "Created (first)": 5
            },
            "renameByName": {
              "Output (first)": "Output",
              "Input (first)": "Input",
              "Vault Balance (first)": "Vault Balance",
              "IO Ratio (first)": "IO Ratio",
              "Created (first)": "Created"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Output"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Input"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Vault Balance"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "IO Ratio"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Order Hash"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Created"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Vault Balance"
            },
            "properties": [
              {
                "id": "unit",
                "value": "locale"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
