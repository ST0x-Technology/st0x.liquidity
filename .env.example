# Turnkey test org credentials for `cargo test -p st0x-evm --features turnkey -- --ignored`
# Set exactly one credential: TURNKEY_API_PRIVATE_KEY, or TURNKEY_KMS_KEY_VERSION
# (KMS-stamped; export GOOGLE_OAUTH_ACCESS_TOKEN=$(gcloud auth print-access-token)).
TURNKEY_API_PRIVATE_KEY=<hex-encoded-p256-api-private-key>
# TURNKEY_KMS_KEY_VERSION=projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>/cryptoKeyVersions/<n>
TURNKEY_ORG_ID=<turnkey-organization-id>
TURNKEY_ADDRESS=<0x-ethereum-address-managed-by-turnkey>

# Alpaca Broker API sandbox credentials for whitelist/travel-rule integration test
# `alpaca_wallet::whitelist::tests::sandbox_whitelist_operations`
ALPACA_BROKER_ACCOUNT_ID=<account-uuid>
ALPACA_BROKER_API_KEY=<broker-api-key>
ALPACA_BROKER_API_SECRET=<broker-api-secret>
