# HELP liq_bot_info Always 1; git_commit is the first 12 characters of the running build
# TYPE liq_bot_info gauge
liq_bot_info{git_commit="0123456789ab"} 1
# TYPE liq_bot_start_timestamp_seconds gauge
liq_bot_start_timestamp_seconds 1700000000.0
