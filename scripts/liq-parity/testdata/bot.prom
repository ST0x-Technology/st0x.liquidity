liq_settings_cash_reserved 1000
# TYPE liq_asset_rebalancing gauge
liq_asset_rebalancing{symbol="AAPL"} 1
# TYPE liq_equity_total gauge
liq_equity_total{symbol="AAPL"} 5
# TYPE liq_usdc_chain_available gauge
liq_usdc_chain_available{chain="robinhood"} 10
